AWS_PROFILE=your-profile-name
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
STAGING_DB_PATH=data/staging.db
BEDROCK_CONNECT_TIMEOUT=5
BEDROCK_READ_TIMEOUT=60
BEDROCK_MAX_TOKENS=1024
BEDROCK_INPUT_PRICE_PER_MTOK=3.00
BEDROCK_OUTPUT_PRICE_PER_MTOK=15.00
# Leaving either of these two empty keeps tracing off (the default).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# "dev" or "prod"; tags every Langfuse trace with this as its environment.
APP_ENV=dev
